# sdkconfig.defaults
# Size flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
#
# Partition Table
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set
# CONFIG_PARTITION_TABLE_TWO_OTA is not set
# CONFIG_PARTITION_TABLE_TWO_OTA_LARGE is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
#
# WiFi Configuration
CONFIG_SERVER_IP="192.168.1.16"
CONFIG_SERVER_PORT=3333
CONFIG_CLIENT_PORT=4444
CONFIG_ESP_WIFI_SSID="esp32"
CONFIG_ESP_WIFI_PASSWORD="93074zar"
CONFIG_ESP_STATION_EXAMPLE_WPA3_SAE_PWE_BOTH=y
CONFIG_ESP_WIFI_PW_ID=""
CONFIG_ESP_MAXIMUM_RETRY=50
CONFIG_ESP_WIFI_AUTH_WPA2_PSK=y
#
# LCD Display Configuration
CONFIG_LCD_WIDTH=320
CONFIG_LCD_HEIGHT=480
CONFIG_LCD_SCLK_GPIO=14
CONFIG_LCD_MOSI_GPIO=13
CONFIG_LCD_MISO_GPIO=12
CONFIG_LCD_CS_GPIO=15
CONFIG_LCD_DC_GPIO=2
CONFIG_LCD_RST_GPIO=2
CONFIG_LCD_BL_GPIO=27

CONFIG_LV_CONF_SKIP=n

# LVGL - отключить монитор производительности (требует LV_USE_SYSMON)
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
CONFIG_LV_USE_SYSMON=n
#
# Оптимизация
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
